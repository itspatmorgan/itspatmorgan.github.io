---
interface Props { kind: "local" | "published" }
const { kind } = Astro.props;
const prefix = `workflow-${kind}`;
---
<div class="workflow-art">
  <svg viewBox="0 0 400 240" role="img" aria-label={kind === "local" ? "A prominent local agent chat panel, with Design Studio integrated beside the conversation." : "A published Design Studio window with a prominent share link in front."}>
    <defs>
      <pattern id={`${prefix}-grid`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" stroke="currentColor" stroke-opacity=".07" stroke-width=".6" fill="none" /></pattern>
      <pattern id={`${prefix}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V6" stroke="currentColor" stroke-opacity=".15" /></pattern>
    </defs>
    <rect x="16" y="16" width="368" height="208" fill={`url(#${prefix}-grid)`} />
    <path d="M16 28H384M28 16V224M372 16V224M16 212H384" class="construction" />
    {kind === "local" ? <>
      <rect x="33" y="39" width="340" height="170" rx="3" fill={`url(#${prefix}-hatch)`} />
      <rect x="26" y="32" width="340" height="170" rx="3" class="sheet" />
      <rect x="26" y="32" width="4" height="170" fill="var(--accent)" opacity=".65" />
      <path d="M26 61H366M198 32V202" class="construction" />
      <text x="44" y="51" class="mono">Agent</text>
      <text x="213" y="51" class="mono">Design Studio</text>
      <rect x="44" y="77" width="136" height="32" rx="3" class="tile" />
      <path d="M55 88H166M55 98H138" class="ink" />
      <path d="M44 125H55" class="accent" />
      <path d="M44 138H176M44 148H155M44 158H165" class="ink" />
      <rect x="44" y="174" width="136" height="17" rx="2" class="tile" />
      <path d="M55 183H125" class="ink" />
      <g opacity=".65">
        <path d="M214 80H350M214 181H350M222 73V188M342 73V188" class="construction" />
        <path d="M259 121H278V104H305M278 121V152H305" class="accent" />
        <rect x="232" y="107" width="27" height="29" rx="2" class="sheet" />
        <path d="M240 117H251M240 126H247" class="ink" />
        <rect x="305" y="92" width="29" height="25" rx="2" class="sheet" />
        <path d="M312 102H327M312 110H321" class="ink" />
        <rect x="305" y="139" width="29" height="30" rx="2" class="sheet" />
        <rect x="312" y="147" width="15" height="14" fill={`url(#${prefix}-hatch)`} />
      </g>
    </> : <>
      <g transform="rotate(-3 166 106)">
        <rect x="46" y="38" width="240" height="142" rx="3" fill={`url(#${prefix}-hatch)`} />
        <rect x="39" y="31" width="240" height="142" rx="3" class="sheet" />
        <text x="53" y="51" class="mono">Design Studio</text>
        <path d="M39 62H279" class="construction" />
        <rect x="54" y="77" width="58" height="80" fill={`url(#${prefix}-hatch)`} />
        <path d="M127 82H263M127 93H237" class="ink" />
        <rect x="127" y="109" width="59" height="28" rx="2" class="tile" />
        <rect x="195" y="109" width="68" height="28" rx="2" class="tile" />
        <path d="M127 152H244" class="ink" />
      </g>
      <rect x="115" y="146" width="245" height="57" rx="3" fill={`url(#${prefix}-hatch)`} />
      <rect x="108" y="139" width="245" height="57" rx="3" class="sheet" />
      <rect x="108" y="139" width="4" height="57" fill="var(--accent)" opacity=".75" />
      <g transform="translate(128 152)" stroke="var(--accent)" stroke-width="2" fill="none">
        <path d="m10 12 6-6a7 7 0 0 1 10 10l-6 6M16 18l-6 6a7 7 0 0 1-10-10l6-6M8 20l10-10" />
      </g>
      <text x="174" y="163" class="link-title">Share link</text>
      <path d="M174 178H335" class="ink" />
    </>}

  </svg>
</div>
<style>
  .workflow-art { color: var(--foreground); margin-bottom: 1.5rem; }
  svg { display: block; width: 100%; height: auto; }
  .construction { fill: none; stroke: currentColor; stroke-width: .7; opacity: .2; }
  .sheet { fill: var(--background); stroke: currentColor; stroke-width: 1; stroke-opacity: .3; }
  .tile { fill: var(--card); stroke: currentColor; stroke-width: .7; stroke-opacity: .25; }
  .ink { fill: none; stroke: currentColor; stroke-width: 1; opacity: .5; }
  .accent { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .link-title { font: 500 14px var(--font-sans); fill: var(--foreground); }
  .mono { font: 11px var(--font-mono); fill: var(--muted-foreground); }
</style>
