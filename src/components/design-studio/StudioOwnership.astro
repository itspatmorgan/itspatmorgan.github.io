---
interface Props { kind: number }
const { kind } = Astro.props;
---
<div class="ownership-art">
  <svg viewBox="0 0 320 220" role="img" aria-label={kind === 0 ? 'An initial interface becomes a customized version with a new theme and layout.' : kind === 1 ? 'ChatGPT Codex, Claude Code, and Cursor app marks on separate sheets connected to one Design Studio.' : 'Overlapping source-file sheets labeled prototype.tsx, context.md, flow.mermaid, and canvas.excalidraw, with distinct textures.'}>
    <defs>
      <pattern id={`ownership-dots-${kind}`} width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".6" fill="currentColor" /></pattern>
      <pattern id={`ownership-hatch-${kind}`} width="6" height="6" patternUnits="userSpaceOnUse"><path d="M0 6 6 0" stroke="currentColor" stroke-width=".65" /></pattern>
    </defs>
    {kind === 0 && <>
      <path d="M24 24H296M24 196H296M34 14V206M286 14V206" class="construction" />
      <g transform="rotate(-4 110 87)">
        <rect x="31" y="32" width="158" height="105" rx="3" class="sheet" />
        <path d="M31 52H189" class="construction" />
        <path d="M43 42H72" class="ink" />
        <rect x="43" y="64" width="32" height="60" rx="1" class="tile" />
        <path d="M86 68H175M86 78H152M86 95H175M86 104H163M86 114H156" class="ink" />
      </g>
      <path d="M206 53H256V81m-5-6 5 6 5-6" class="icon" opacity=".65" />
      <rect x="120" y="102" width="171" height="99" rx="3" fill={`url(#ownership-hatch-${kind})`} opacity=".3" />
      <rect x="113" y="95" width="171" height="99" rx="3" class="sheet" />
      <path d="M113 115H284" class="construction" />
      <rect x="113" y="95" width="4" height="99" fill="var(--accent)" opacity=".7" />
      <rect x="126" y="103" width="8" height="5" fill="var(--accent)" opacity=".75" />
      <path d="M142 106H163" class="ink" />
      <rect x="126" y="127" width="40" height="54" fill={`url(#ownership-hatch-${kind})`} opacity=".35" />
      <path d="M178 131H269M178 140H247" class="ink" />
      <rect x="178" y="151" width="37" height="18" rx="4" fill="var(--accent)" opacity=".3" />
      <rect x="223" y="151" width="46" height="18" rx="4" class="tile" />
      <path d="M178 180H257" class="ink" />
    </>}
    {kind === 1 && <>
      <path d="M24 24H296M24 196H296M34 14V206M286 14V206" class="construction" />
      <path d="M95 52H126V109H160M95 109H160M95 167H126V109" class="icon" opacity=".6" />
      {['square-chatgpt.svg', 'square-claude.svg', 'cursor.svg'].map((logo, index) => (
        <g transform={`rotate(${index === 0 ? -3 : index === 2 ? 3 : 0} 63 ${52 + index * 57})`}>
          <rect x="30" y={32 + index * 57} width="66" height="40" rx="3" class="sheet" />
          <mask id={`ownership-agent-${index}`} style="mask-type: alpha">
            <image href={`/images/logos/${logo}`} x="39" y={41 + index * 57} width="22" height="22" />
          </mask>
          <rect x="39" y={41 + index * 57} width="22" height="22" fill="currentColor" mask={`url(#ownership-agent-${index})`} opacity=".8" />
          <path d={`M70 ${48 + index * 57}H85M70 ${56 + index * 57}H80`} class="ink" />
        </g>
      ))}
      <rect x="167" y="45" width="123" height="138" rx="3" fill={`url(#ownership-hatch-${kind})`} opacity=".3" />
      <rect x="160" y="38" width="123" height="138" rx="3" class="sheet" />
      <text x="172" y="57" class="mono">Design Studio</text>
      <path d="M160 68H283" class="construction" />
      <rect x="172" y="80" width="99" height="42" rx="2" class="tile" />
      <rect x="181" y="89" width="24" height="24" fill="var(--accent)" opacity=".22" />
      <path d="M214 92H259M214 101H250M214 110H255" class="ink" />
      <path d="M172 137H270M172 147H252M172 157H261" class="ink" />
    </>}
    {kind === 2 && <>
      <g transform="rotate(-5 164 107)">
        <rect x="66" y="27" width="206" height="116" rx="2" class="sheet" /><text x="82" y="49" class="files">canvas.excalidraw</text>
        <rect x="83" y="58" width="169" height="70" fill={`url(#ownership-dots-${kind})`} opacity=".23" />
      </g>
      <g transform="rotate(3 158 115)">
        <rect x="50" y="64" width="211" height="112" rx="2" class="sheet" /><text x="66" y="86" class="files">flow.mermaid</text>
        <rect x="65" y="97" width="179" height="62" fill={`url(#ownership-hatch-${kind})`} opacity=".18" />
      </g>
      <rect x="40" y="99" width="220" height="92" rx="2" class="sheet" /><text x="56" y="122" class="files">context.md</text>
      <path d="M56 133H240M56 144H216M56 155H228" class="ink" />
      <rect x="30" y="142" width="228" height="62" rx="2" class="sheet" />
      <rect x="30" y="142" width="5" height="62" fill="var(--accent)" />
      <text x="47" y="166" class="files">prototype.tsx</text><path d="m49 177 5 5-5 5M62 187H81M95 181H235" class="ink" />
    </>}
  </svg>
</div>
<style>
  .ownership-art { color:var(--foreground); padding:.75rem 0 1.5rem; }
  svg { display:block; width:100%; max-width:24rem; margin:auto; }
  .construction { fill:none; stroke:currentColor; stroke-width:.7; opacity:.22; }
  .sheet { fill:var(--background); stroke:currentColor; stroke-opacity:.35; }
  .tile { fill:var(--card); stroke:currentColor; stroke-opacity:.22; }
  .icon { fill:none; stroke:var(--accent); stroke-width:1.2; }
  .ink { fill:none; stroke:currentColor; stroke-width:1.1; opacity:.5; }
  .mono { font:10px var(--font-mono); fill:var(--muted-foreground); }
  .reverse { fill:var(--background); }
  .files { font:12px var(--font-mono); fill:var(--foreground); }
  .ghost { fill:none; stroke:currentColor; stroke-dasharray:3 5; opacity:.2; }
  .cursor { fill:var(--foreground); stroke:var(--background); stroke-width:1; }
</style>
