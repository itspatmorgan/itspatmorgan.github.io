---
interface Props { kind: number }
const { kind } = Astro.props;
---
<div class="ownership-art">
  <svg viewBox="0 0 320 220" role="img" aria-label={kind === 0 ? 'A ready-to-use Design Studio with views, diagrams, canvases, and documents.' : kind === 1 ? 'A coding agent and Design Studio working side by side.' : 'Your Design Studio folder contains source files you can own, edit, and extend.'}>
    <defs><pattern id={`ownership-grid-${kind}`} width="16" height="16" patternUnits="userSpaceOnUse"><path d="M16 0H0V16" fill="none" stroke="currentColor" opacity=".06"/></pattern></defs>
    <rect x="12" y="12" width="296" height="196" fill={`url(#ownership-grid-${kind})`}/>
    <path d="M12 24H308M24 12V208M296 12V208M12 196H308" class="construction"/>
    {kind === 0 && <>
      <rect x="42" y="39" width="236" height="144" rx="4" class="sheet"/>
      <path d="M42 64H278" class="construction"/><circle cx="56" cy="52" r="2" fill="var(--accent)"/><text x="65" y="55" class="mono">Design Studio</text>
      <g class="tile"><rect x="55" y="78" width="99" height="42" rx="2"/><rect x="166" y="78" width="99" height="42" rx="2"/><rect x="55" y="130" width="99" height="42" rx="2"/><rect x="166" y="130" width="99" height="42" rx="2"/></g>
      <g class="icon"><rect x="65" y="88" width="18" height="19" rx="1"/><path d="M65 94H83M71 94V107M180 87V107m-6-14 6-6 6 6m-6 14h12M66 142l13-3 6 17-16 4-3-18ZM177 140H191V162H177zM181 145H187M181 150H187M181 155H185"/></g>
      <g class="label"><text x="93" y="103">View</text><text x="202" y="103">Diagram</text><text x="94" y="156">Canvas</text><text x="202" y="156">Document</text></g>
    </>}
    {kind === 1 && <>
      <g transform="rotate(-3 109 99)"><rect x="38" y="41" width="160" height="118" rx="4" class="sheet"/><path d="M38 66H198" class="construction"/><text x="52" y="57" class="mono">Your coding agent</text><path d="m55 83 8 7-8 7M73 97H87" class="icon"/><path d="M53 112H138M53 124H175M53 136H123" class="ink"/></g>
      <g transform="rotate(3 218 132)"><rect x="145" y="85" width="145" height="106" rx="4" class="sheet"/><path d="M145 110H290" class="construction"/><text x="159" y="102" class="mono">Design Studio</text><rect x="157" y="125" width="37" height="46" fill="var(--accent)" opacity=".18"/><path d="M204 128H273M204 139H259M204 155H273M204 166H252" class="ink"/></g>
    </>}
    {kind === 2 && <>
      <path d="M56 48H130L145 62H264V182H56V48Z" fill="var(--card)" stroke="var(--border)"/>
      <rect x="48" y="68" width="224" height="120" rx="3" class="sheet"/><text x="65" y="92" class="mono">your-studio/</text>
      <path d="M69 104V170M69 111H83M69 131H83M69 151H83M69 171H83" class="icon"/>
      <g class="files"><text x="94" y="115">prototype.tsx</text><text x="94" y="135">context.md</text><text x="94" y="155">flow.mermaid</text><text x="94" y="175">canvas.excalidraw</text></g>
      <path d="M260 36h20m-10-10v20" class="icon"/>
    </>}
  </svg>
</div>
<style>
  .ownership-art { color:var(--foreground); padding:.75rem 0 1.5rem; }
  svg { display:block;width:100%;max-width:24rem;margin:auto; }
  .construction { fill:none;stroke:currentColor;stroke-width:.7;opacity:.18; }
  .sheet { fill:var(--background);stroke:var(--muted-foreground);stroke-opacity:.35; }
  .tile { fill:var(--card);stroke:var(--border); }
  .icon { fill:none;stroke:var(--accent);stroke-width:1.1; }
  .ink { stroke:currentColor;stroke-width:1;opacity:.35; }
  .mono { font:10px var(--font-mono);fill:var(--muted-foreground); }
  .label { font:10px var(--font-sans);fill:var(--foreground); }
  .files { font:11px var(--font-mono);fill:var(--foreground); }
</style>
