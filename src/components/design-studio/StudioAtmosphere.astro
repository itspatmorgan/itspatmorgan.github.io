---
interface Props { interactive?: boolean }
const { interactive = true } = Astro.props;
---
<div class="studio-atmosphere relative mr-auto w-full max-w-[400px] text-foreground lg:mx-auto lg:max-w-lg" data-studio-atmosphere={interactive ? "" : undefined}>
  <div class="atmosphere-art" role="img" aria-label="A shared drafting table: you and a coding agent work on source files that become a view, diagram, document, and canvas.">
    <svg viewBox="0 0 560 480" fill="none" class="block w-full" aria-hidden="true">
      <defs>
        <pattern id="studio-drafting-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" stroke="currentColor" stroke-opacity="0.07" stroke-width="0.6" /></pattern>
        <pattern id="studio-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V7" stroke="currentColor" stroke-opacity="0.13" stroke-width="1" /></pattern>
      </defs>
      <rect x="16" y="16" width="528" height="430" fill="url(#studio-drafting-grid)" />
      <g stroke="currentColor" opacity="0.24" stroke-width="0.7">
        <path d="M16 32H544M32 16V446M528 16V446M16 430H544" />
        <path d="M20 32H44M32 20V44M516 32H540M528 20V44M20 430H44M32 418V442M516 430H540M528 418V442" />
      </g>
      <path d="M450 365H544V446H450Z" fill="url(#studio-hatch)" />
      <g transform="translate(0 34)">
      <g class="parallax-near">
        <g stroke="var(--accent)" stroke-width="1.2">
          <path d="M260 114H280V295H302M280 130H302M280 284H260" opacity="0.55" />
          <path class="draft-trace" d="M260 114H280V295H302M280 130H302M280 284H260" opacity="0.7" />
        </g>
        <g transform="rotate(-3 154 106)">
          <rect x="42" y="40" width="222" height="138" rx="3" fill="var(--card)" stroke="currentColor" stroke-opacity="0.3" />
          <path d="M42 67H264" stroke="currentColor" opacity="0.15" />
          <text x="54" y="58" class="file-label">view.tsx</text>
          <text x="56" y="89" class="artifact-title">Prototype</text>
          <rect x="220" y="79" width="30" height="11" rx="2" fill="var(--accent)" opacity="0.35" />
          <path d="M56 105H250M56 122H250M56 139H250M56 156H250" stroke="currentColor" opacity="0.12" />
          <path d="M60 114H130M60 131H153M60 148H118" stroke="currentColor" stroke-width="2" opacity="0.4" />
          <path d="M196 114H212M196 131H212M196 148H212" stroke="var(--accent)" stroke-width="4" opacity="0.45" />
        </g>
        <g transform="rotate(3 409 136)">
          <rect x="298" y="68" width="222" height="136" rx="3" fill="var(--card)" stroke="currentColor" stroke-opacity="0.3" />
          <text x="310" y="86" class="file-label">flow.mermaid</text>
          <path d="M298 95H520" stroke="currentColor" opacity="0.15" />
          <g stroke="currentColor" stroke-width="0.9" opacity="0.65">
            <rect x="312" y="128" width="49" height="24" /><path d="M374 140L397 117L420 140L397 163Z" /><rect x="450" y="108" width="54" height="24" /><rect x="450" y="158" width="54" height="24" />
            <path d="M361 140H374M420 140L450 120M420 140L450 170" />
          </g>
          <text x="320" y="143" class="tiny-label">Capture</text><text x="384" y="143" class="tiny-label">Review</text><text x="462" y="123" class="tiny-label">Act</text><text x="460" y="173" class="tiny-label">Later</text>
        </g>
        <g transform="rotate(2 170 283)">
          <rect x="74" y="206" width="190" height="150" rx="3" fill="var(--card)" stroke="currentColor" stroke-opacity="0.3" />
          <text x="88" y="225" class="file-label">context.md</text>
          <path d="M74 235H264" stroke="currentColor" opacity="0.15" />
          <text x="90" y="256" class="artifact-title"># Project context</text>
          <text x="90" y="279" class="tiny-label">The problem</text>
          <path d="M90 290H246M90 299H234M90 308H242" stroke="currentColor" opacity="0.3" />
          <text x="90" y="331" class="tiny-label">What we're exploring</text>
          <path d="M90 341H228" stroke="currentColor" opacity="0.3" />
        </g>
        <g transform="rotate(-2 408 291)">
          <rect x="298" y="226" width="222" height="132" rx="3" fill="var(--card)" stroke="currentColor" stroke-opacity="0.3" />
          <text x="310" y="245" class="file-label">board.excalidraw</text>
          <path d="M298 254H520" stroke="currentColor" opacity="0.15" />
          <rect x="315" y="272" width="72" height="48" fill="url(#studio-hatch)" stroke="currentColor" stroke-opacity="0.35" />
          <path d="M325 284H376M325 292H366M325 300H372" stroke="currentColor" opacity="0.35" />
          <path d="M404 282L430 269L447 288L425 306ZM447 288L478 290M466 280L496 282L493 312L464 310Z" stroke="currentColor" opacity="0.65" />
          <path d="M330 335Q368 317 395 335T492 330" stroke="var(--accent)" stroke-width="1.5" opacity="0.75" />
        </g>
      </g>
      <g class="parallax-front">
        <g class="human-cursor" transform="translate(213 143)">
          <path d="M0 0V18L5 13L10 21L14 19L9 11H17Z" fill="currentColor" stroke="var(--background)" stroke-width="1.5" />
          <rect x="14" y="19" width="44" height="23" rx="3" fill="var(--foreground)" /><text x="22" y="35" class="cursor-label" fill="var(--background)">You</text>
        </g>
        <g transform="translate(218 296)">
          <g class="agent-cursor">
            <path d="M0 0V18L5 13L10 21L14 19L9 11H17Z" fill="var(--accent)" stroke="var(--background)" stroke-width="1.5" />
            <rect x="14" y="19" width="58" height="23" rx="3" fill="var(--accent)" /><text x="22" y="32" class="cursor-label" fill="var(--background)">Agent</text>
          </g>
        </g>
      </g>
      </g>
    </svg>
  </div>
  {interactive && <button type="button" data-atmosphere-pause hidden aria-pressed="false" class="absolute right-0 bottom-0 rounded px-2 py-1 font-mono text-[10px] text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring">Pause motion</button>}
</div>

<style>
  .studio-atmosphere { isolation: isolate; }
  .studio-atmosphere::before { content: ""; position: absolute; inset: 10% 0; z-index: -1; background: radial-gradient(ellipse at center, var(--accent), transparent 65%); opacity: 0.035; }
  .parallax-near { transform: translate(var(--studio-x, 0px), var(--studio-y, 0px)); }
  .parallax-front { transform: translate(calc(var(--studio-x, 0px) * 0.5), calc(var(--studio-y, 0px) * 0.5)); }
  .parallax-near, .parallax-front { transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .file-label, .cursor-label { font-family: var(--font-mono); }
  .file-label { fill: currentColor; font-size: 12px; opacity: 0.8; }
  .artifact-title { fill: currentColor; font-family: var(--font-sans); font-size: 13px; font-weight: 500; }
  .tiny-label { fill: currentColor; font-family: var(--font-sans); font-size: 9px; opacity: 0.75; }
  .cursor-label { font-size: 12px; }
  [data-initialized="true"] .draft-trace { stroke-dasharray: 8 10; animation: draft-connect 16s linear infinite; }
  [data-initialized="true"] .agent-cursor { animation: draft-agent 12s ease-in-out infinite; }
  @keyframes draft-connect { to { stroke-dashoffset: -144; } }
  @keyframes draft-agent { 0%, 100% { transform: translate(0, 0); } 40%, 65% { transform: translate(-32px, -20px); } }
  .studio-atmosphere[data-paused="true"] :is(.draft-trace, .agent-cursor),
  .studio-atmosphere[data-in-view="false"] :is(.draft-trace, .agent-cursor) { animation-play-state: paused; }
  [data-paused="true"] .parallax-near, [data-paused="true"] .parallax-front { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-initialized="true"] .draft-trace, [data-initialized="true"] .agent-cursor { animation: none; }
    .parallax-near, .parallax-front { transform: none; transition: none; }
    [data-atmosphere-pause] { display: none; }
  }
</style>

<script>
  function initAtmosphere() {
    const root = document.querySelector<HTMLElement>("[data-studio-atmosphere]");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const hero = root.closest<HTMLElement>(".studio-hero");
    const button = root.querySelector<HTMLButtonElement>("[data-atmosphere-pause]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let paused = false;
    const reset = () => { root.style.removeProperty("--studio-x"); root.style.removeProperty("--studio-y"); };
    if (button) {
      button.hidden = reduced.matches;
      button.addEventListener("click", () => {
        paused = !paused;
        root.dataset.paused = String(paused);
        button.setAttribute("aria-pressed", String(paused));
        button.textContent = paused ? "Resume motion" : "Pause motion";
        reset();
      });
    }
    hero?.addEventListener("pointermove", (event) => {
      if (reduced.matches || paused || event.pointerType !== "mouse") return;
      const rect = hero.getBoundingClientRect();
      root.style.setProperty("--studio-x", `${((event.clientX - rect.left) / rect.width - 0.5) * 24}px`);
      root.style.setProperty("--studio-y", `${((event.clientY - rect.top) / rect.height - 0.5) * 24}px`);
    });
    hero?.addEventListener("pointerleave", reset);
    const syncVisibility = () => { root.dataset.inView = String(!document.hidden && visible); };
    let visible = true;
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncVisibility(); });
    observer.observe(root);
    document.addEventListener("visibilitychange", syncVisibility);
    const syncReduced = () => { reset(); if (button) button.hidden = reduced.matches; };
    reduced.addEventListener("change", syncReduced);
    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      document.removeEventListener("visibilitychange", syncVisibility);
      reduced.removeEventListener("change", syncReduced);
    }, { once: true });
  }
  initAtmosphere();
  document.addEventListener("astro:after-swap", initAtmosphere);
</script>
