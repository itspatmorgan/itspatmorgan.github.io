---
interface Props { kind: string }
const { kind } = Astro.props;
const feedback = [
  { title: "Export to CSV is missing columns", from: "Maya Chen", source: "Email", priority: "High", status: "New" },
  { title: "Dark mode makes status badges hard to read", from: "Luis Ortega", source: "Chat", priority: "Medium", status: "Triaged" },
  { title: "Let me bulk-assign items to a teammate", from: "Priya Nair", source: "Interview", priority: "High", status: "New" },
];
---
<div class="artifact-stage">
  <div class="artifact-file"><span class="file-dot" aria-hidden="true"></span><span>{kind === 'view' ? 'feedback-inbox.tsx' : kind === 'diagram' ? 'triage-flow.mermaid' : kind === 'canvas' ? 'explorations.excalidraw' : 'context.md'}</span><span class="file-type">{kind === 'view' ? 'Working view' : kind === 'diagram' ? 'Flow diagram' : kind === 'canvas' ? 'Exploration canvas' : 'Design context'}</span></div>
  {kind === 'view' && <div class="feedback-view" data-feedback-demo>
    <div class="feedback-heading"><div><h4>Feedback inbox</h4></div><svg class="feedback-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 10h32v25H25l-9 7v-7H8V10Zm8 8h16M16 25h10" stroke="currentColor" stroke-width="1.5"/></svg></div>
    <p class="feedback-intro">Everything customers have told us, and what needs attention.</p>
    <div class="feedback-filters" role="group" aria-label="Filter feedback"><button type="button" data-feedback-filter="all" aria-pressed="true">All feedback <span>3</span></button><button type="button" data-feedback-filter="new" aria-pressed="false">New <span data-new-count>2</span></button><button type="button" data-feedback-filter="triaged" aria-pressed="false">Triaged <span data-triaged-count>1</span></button></div>
    <div class="feedback-columns" aria-hidden="true"><span>Feedback</span><span>Priority</span><span>Status</span></div>
    <div class="feedback-list">{feedback.map(item => <article class="feedback-item" data-feedback-item data-status={item.status.toLowerCase()}><div class="feedback-item-text"><h5>{item.title}</h5><p>{item.from} · {item.source}</p></div><span class:list={['feedback-priority', { 'priority-high': item.priority === 'High' }]}>{item.priority}</span><button type="button" class="feedback-status" data-triage-feedback aria-label={`Mark ${item.title} as ${item.status === 'New' ? 'triaged' : 'new'}`}>{item.status}</button></article>)}</div>
    <p class="feedback-empty" data-feedback-empty hidden>No feedback in this status.</p>
    <p class="sr-only" role="status" aria-live="polite" data-feedback-status></p>
  </div>}
  {kind === 'diagram' && <div class="diagram-view"><h4>Give every request a direction.</h4><svg class="flow-drawing" viewBox="0 0 640 340" role="img" aria-label="Capture feedback, review its priority, then plan it or keep it for later. Later requests return for review."><defs><marker id="feedback-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="m1 1 8 4-8 4" fill="none" stroke="currentColor" stroke-width="1.5"/></marker></defs><g class="flow-lines" marker-end="url(#feedback-arrow)"><path d="M167 160H230"/><path d="M356 160H392V86H474"/><path d="M356 160H392V234H474"/><path d="M545 258V310H293V212"/></g><g class="flow-nodes"><rect x="34" y="136" width="133" height="48" rx="6"/><path d="m230 160 63-52 63 52-63 52-63-52Z"/><rect x="474" y="62" width="142" height="48" rx="6"/><rect x="474" y="210" width="142" height="48" rx="6"/></g><g class="flow-labels"><text x="100" y="165">Capture feedback</text><text x="293" y="165">Review priority</text><text x="545" y="91">Plan next step</text><text x="545" y="239">Keep for later</text></g><g class="flow-annotations"><text x="433" y="72" text-anchor="middle">Act now</text><text x="433" y="220" text-anchor="middle">Not yet</text><text x="419" y="296" text-anchor="middle">Revisit as needs change</text></g></svg><ol class="mobile-flow" aria-label="Feedback triage flow"><li>Capture feedback</li><li>Review priority</li><li><span>Plan next step</span><span>Keep for later</span></li></ol><p class="mobile-flow-return">Revisit deferred requests as customer needs change.</p></div>}
  {kind === 'canvas' && <div class="canvas-view"><div class="canvas-note"><p class="small-note">A direction to explore</p><h4>Less backlog.<br />More clarity.</h4><p>Help product teams see what matters and decide what to do next.</p></div><div class="canvas-sketch"><span class="sketch-label">Triage workspace</span><div class="sketch-top"></div><div class="sketch-tabs"><i></i><i></i><i></i></div>{[1,2,3].map(()=> <div class="sketch-row"><span></span><div><i></i><i></i></div><b>◇</b></div>)}</div><div class="canvas-question"><span>What if…</span><p>Every piece of feedback had a clear next step?</p></div><svg class="canvas-connection" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true"><path d="M215 125C280 125 270 95 340 95M430 235C430 300 300 310 245 285" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 5" fill="none"/></svg></div>}
  {kind === 'document' && <div class="document-view"><h4>Turn feedback into decisions.</h4><p class="document-intro">Give product teams a shared place to review customer requests, weigh their impact, and decide what comes next.</p><div class="document-section"><h5>What matters</h5><ul><li>Keep the customer's source visible.</li><li>Show priority and status at a glance.</li><li>Make triage a simple action in the inbox.</li></ul></div><div class="document-decision"><span class="small-note">Design decision</span><p>Keep priority separate from status. A high-impact request may still need investigation before it belongs in the plan.</p></div><p class="document-link">Related artifacts <span>feedback-inbox.tsx · triage-flow.mermaid</span></p></div>}
</div>

<style>
  .artifact-stage { background: var(--background); color: var(--foreground); min-height: 30rem; }
  .artifact-file { display:flex; align-items:center; gap:.6rem; padding:1rem 1.5rem; border-bottom:1px solid var(--border); font: .7rem var(--font-mono); color:var(--muted-foreground); }
  .file-dot { width:6px; height:6px; border-radius:50%; background:var(--accent); }
  .file-type { margin-left:auto; opacity:.85; }
  h4 { font-size:clamp(1.5rem,2.5vw,2rem); letter-spacing:-.04em; font-weight:500; line-height:1.15; }
  .small-note { color:var(--muted-foreground); font-size:.75rem; margin-bottom:.7rem; }
  .feedback-view,.diagram-view,.document-view { padding:2rem clamp(1.25rem,3vw,3rem); }
  .feedback-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .feedback-mark { width:36px; color:var(--accent); }
  .feedback-intro { font-size:.8rem; line-height:1.6; color:var(--muted-foreground); margin-top:.8rem; }
  .feedback-filters { display:flex; gap:1.4rem; margin:1.5rem 0 1rem; border-bottom:1px solid var(--border); }
  .feedback-filters button { padding:.7rem 0; font-size:.75rem; color:var(--muted-foreground); border-bottom:1px solid transparent; }
  .feedback-filters button[aria-pressed="true"] { color:var(--foreground); border-color:var(--accent); }
  .feedback-filters span { font:.7rem var(--font-mono); margin-left:.3rem; }
  button { cursor:pointer; }
  button:focus-visible { outline:2px solid var(--ring); outline-offset:4px; border-radius:3px; }
  [hidden] { display:none !important; }
  .feedback-columns,.feedback-item { display:grid; grid-template-columns:minmax(0,1fr) 4.5rem 4.5rem; gap:1rem; align-items:center; }
  .feedback-columns { font:.7rem var(--font-mono); color:var(--muted-foreground); padding:.6rem 0; }
  .feedback-item { padding:1.35rem 0; border-top:1px solid var(--border); }
  .feedback-item h5 { font-size:.9rem; font-weight:500; letter-spacing:-.02em; line-height:1.5; }
  .feedback-item-text p { margin-top:.4rem; font-size:.7rem; color:var(--muted-foreground); }
  .feedback-priority { font:.7rem var(--font-mono); color:var(--muted-foreground); }
  .priority-high { color:var(--foreground); }
  .feedback-status { justify-self:start; font-size:.7rem; padding:.35rem .55rem; border-radius:4px; background:var(--muted); color:var(--muted-foreground); }
  [data-status="new"] .feedback-status { background:color-mix(in oklch,var(--accent) 15%,var(--background)); color:var(--foreground); }
  .feedback-status:hover { outline:1px solid var(--accent); }
  .feedback-empty { padding:3rem 0; font-size:.85rem; color:var(--muted-foreground); }
  .diagram-view { padding-top:2.5rem; }
  .mobile-flow,.mobile-flow-return { display:none; }
  .flow-drawing { width:100%; margin:1rem 0 0;overflow:visible; }
  .flow-lines { stroke:var(--accent);stroke-width:1.3;fill:none; }
  .flow-nodes { stroke:var(--border);fill:var(--card); }
  .flow-labels { fill:var(--foreground);text-anchor:middle;font:12px var(--font-sans); }
  .flow-annotations { fill:var(--muted-foreground);font:10px var(--font-mono); }
  .canvas-view { position:relative; min-height:28rem; background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:18px 18px; padding:2.5rem;display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start; }
  .canvas-note,.canvas-sketch,.canvas-question { position:relative;z-index:1; }
  .canvas-note { padding:1.25rem;background:var(--card);border:1px solid var(--border);transform:rotate(-2deg); }
  .canvas-note h4 { font-size:1.5rem; }
  .canvas-note>p:last-child { font-size:.75rem;line-height:1.7;color:var(--muted-foreground);margin-top:1rem; }
  .canvas-sketch { border:1px solid var(--muted-foreground);border-radius:3px;padding:1.25rem;background:var(--background);transform:rotate(2deg); }
  .sketch-label { font:.6rem var(--font-mono);color:var(--muted-foreground); }
  .sketch-top { height:8px;width:70%;margin:1.2rem 0;background:var(--foreground);opacity:.35; }
  .sketch-tabs { display:flex;gap:.5rem;margin-bottom:.6rem; }
  .sketch-tabs i { width:30px;height:4px;background:var(--accent);opacity:.5; }
  .sketch-row { display:flex;align-items:center;gap:.6rem;padding:.7rem 0;border-top:1px solid var(--border); }
  .sketch-row>span { width:25px;height:30px;border:1px solid var(--muted-foreground); }
  .sketch-row>div { flex:1; }
  .sketch-row i { display:block;width:90%;height:3px;margin:5px 0;background:var(--muted-foreground);opacity:.4; }
  .sketch-row i+i { width:50%; }
  .sketch-row b { font-weight:400;color:var(--accent); }
  .canvas-question { grid-column:1 / -1;justify-self:center;width:65%;padding:.9rem 1rem;border-left:2px solid var(--accent);background:var(--background); }
  .canvas-question span { font:.65rem var(--font-mono);color:var(--accent); }
  .canvas-question p { margin-top:.4rem;font-size:.85rem;line-height:1.5; }
  .canvas-connection { position:absolute;inset:0;width:100%;height:100%;color:var(--accent);opacity:.5; }
  .document-view { max-width:42rem;margin:auto; }
  .document-intro { font-size:.9rem;line-height:1.75;color:var(--muted-foreground);margin-top:1rem; }
  .document-section { margin-top:1.6rem; }
  .document-section h5 { font-size:.85rem;font-weight:500; }
  .document-section ul { list-style:disc;margin:.7rem 0 0 1rem;font-size:.8rem;line-height:1.9;color:var(--muted-foreground); }
  .document-decision { margin-top:1.5rem;padding:1rem 1.25rem;border-left:2px solid var(--accent);background:var(--card); }
  .document-decision p { font-size:.8rem;line-height:1.7; }
  .document-link { margin-top:1.5rem;font-size:.65rem;color:var(--muted-foreground); }
  .document-link span { display:block;margin-top:.4rem;font-family:var(--font-mono);overflow-wrap:anywhere; }
  @media(max-width:40rem) { .file-type { display:none; } .artifact-stage { min-height:0; } .feedback-columns { display:none; } .feedback-item { grid-template-columns:minmax(0,1fr) auto; gap:.5rem 1rem; } .feedback-item-text { grid-column:1 / -1; } .feedback-status { justify-self:end; } .feedback-filters { gap:1rem; } .canvas-view { padding:1.5rem;gap:1.5rem;grid-template-columns:1fr; } .canvas-sketch { width:85%;justify-self:end; } .canvas-question { width:100%; } .canvas-connection { display:none; } .flow-drawing { display:none; } .mobile-flow { display:grid;gap:1.5rem;margin-top:2rem;list-style:none; } .mobile-flow li { position:relative;text-align:center;padding:1rem;border:1px solid var(--border);background:var(--card);border-radius:6px;font-size:.8rem; } .mobile-flow li+li::before { content:"↓";position:absolute;top:-1.3rem;left:50%;color:var(--accent); } .mobile-flow li:last-child { display:flex;gap:1rem;border:0;padding:0;background:none; } .mobile-flow li:last-child span { flex:1;padding:1rem .5rem;border:1px solid var(--border);border-radius:6px;background:var(--card); } .mobile-flow-return { display:block;font-size:.7rem;line-height:1.6;color:var(--muted-foreground);margin-top:1.5rem; } }
</style>
<script>
  function initFeedbackDemo() {
    const root = document.querySelector<HTMLElement>('[data-feedback-demo]');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feedback-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-feedback-item]'));
    let active = 'all';
    const update = () => {
      for (const status of ['new', 'triaged']) {
        const label = root.querySelector('[data-' + status + '-count]');
        if (label) label.textContent = String(items.filter(item => item.dataset.status === status).length);
      }
      items.forEach(item => { item.hidden = active !== 'all' && item.dataset.status !== active; });
      const empty = root.querySelector<HTMLElement>('[data-feedback-empty]');
      if (empty) empty.hidden = items.some(item => !item.hidden);
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.feedbackFilter === active)));
    };
    filters.forEach(button => button.addEventListener('click', () => { active = button.dataset.feedbackFilter || 'all'; update(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-triage-feedback]').forEach(button => button.addEventListener('click', () => {
      const item = button.closest<HTMLElement>('[data-feedback-item]');
      if (!item) return;
      const status = item.dataset.status === 'new' ? 'triaged' : 'new';
      item.dataset.status = status;
      button.textContent = status === 'new' ? 'New' : 'Triaged';
      const title = item.querySelector('h5')?.textContent || 'feedback';
      button.setAttribute('aria-label', 'Mark ' + title + ' as ' + (status === 'new' ? 'triaged' : 'new'));
      const announcement = root.querySelector('[data-feedback-status]');
      if (announcement) announcement.textContent = title + ' marked as ' + status + '.';
      update();
      if (item.hidden) filters.find(filter => filter.dataset.feedbackFilter === active)?.focus();
    }));
  }
  initFeedbackDemo();
  document.addEventListener('astro:after-swap', initFeedbackDemo);
</script>
