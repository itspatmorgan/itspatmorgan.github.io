---
import PageLayout from "@/layouts/PageLayout.astro";
import Icon from "@/components/icons/Icon.astro";
import PixelWaveText from "@/components/PixelWaveText.astro";
import StudioScreenshot from "@/components/design-studio/StudioScreenshot.astro";
import StudioDocumentGallery from "@/components/design-studio/StudioDocumentGallery.astro";
import StudioArtifactExplorer from "@/components/design-studio/StudioArtifactExplorer.astro";
import StudioPreviewCarousel from "@/components/design-studio/StudioPreviewCarousel.astro";
import StudioWorkflow from "@/components/design-studio/StudioWorkflow.astro";
import StudioTeamSpaces from "@/components/design-studio/StudioTeamSpaces.astro";
import StudioFoundation from "@/components/design-studio/StudioFoundation.astro";
import StudioAtmosphere from "@/components/design-studio/StudioAtmosphere.astro";
import agentGuide from "@/data/design-studio-agent.txt?raw";
import { setupGuide, setupPaths, publishingPaths } from "@/data/design-studio-setup";
import { buttonVariants } from "@/components/ui/button";
import { siteConfig } from "@/data/site-config";
import { GithubIcon, UserIcon, Robot01Icon } from "@hugeicons/core-free-icons";

const repository = "https://github.com/itspatmorgan/design-studio-starter";
const liveDemo = "https://itspatmorgan.com/design-studio-starter/";
const feedbackDemo = `${liveDemo}prototypes/ccncfpcyaa1hvjts`;


---

<PageLayout title="Design Studio: Design with intent. Build with an agent." description="A prototype sandbox for designers and product managers who build. Work with your agent locally, then publish interactive prototypes for your team to explore." image="/images/design-studio/social-prototype-sandbox.jpg">
  <div class="studio-page mx-auto w-full max-w-[1200px] px-6 sm:px-8 lg:px-14">
    <header class="studio-header flex items-center justify-between gap-6 pt-9 sm:pt-12">
      <a href="/design-studio" class="studio-brand flex shrink-0 items-center gap-3 font-medium tracking-tight" aria-label="Design Studio home">
        <svg width="32" height="26" viewBox="0 0 40 32" fill="currentColor" aria-hidden="true"><path d="M0 0h11v32H0zM15 0h3a16 16 0 0 1 0 32h-3z" /></svg>
        <span class="text-lg">Design Studio</span>
      </a>
      <div class="studio-header-controls ml-auto flex shrink-0 items-center gap-4 sm:gap-6">
        <a href={repository} aria-label="View Design Studio on GitHub" title="View Design Studio on GitHub" class="studio-github inline-flex min-h-11 items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
          <span aria-hidden="true"><Icon icon={GithubIcon} size={20} /></span>
          <span class="studio-control-label">GitHub</span>
        </a>
        <nav aria-label="Reading mode" class="relative isolate flex rounded-full border border-border p-1" data-studio-modes>
          <span class="mode-indicator" aria-hidden="true" data-mode-indicator></span>
          <a id="studio-human-tab" href="#studio-human" data-studio-mode="human" aria-label="Human" title="Human" class="mode-tab rounded-full px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"><span class="studio-mode-icon" aria-hidden="true"><Icon icon={UserIcon} size={18} /></span><span class="studio-control-label">Human</span></a>
          <a id="studio-agent-tab" href="/design-studio/agent.txt" data-studio-mode="agent" aria-label="Agent" title="Agent" class="mode-tab font-mono rounded-full px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"><span class="studio-mode-icon" aria-hidden="true"><Icon icon={Robot01Icon} size={18} /></span><span class="studio-control-label">Agent</span></a>
        </nav>
      </div>
    </header>

    <div id="studio-human" data-studio-panel="human">
    <section class="studio-hero grid items-center gap-6" aria-labelledby="studio-title">
      <div>
        <h1 id="studio-title" class="text-[clamp(2.5rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.055em]"><PixelWaveText text="Design with intent." wave="studio-headline" initialSans /><br /><PixelWaveText text="Build with an agent." wave="studio-headline" initialSans /></h1>
        <p class="mt-7 max-w-lg text-lg leading-relaxed text-muted-foreground">Design Studio is an open source, AI prototype sandbox for designers and product managers who build.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#get-started" class={buttonVariants({ size: "lg", className: "h-11 px-5" })}>Set up Design Studio <span aria-hidden="true">↓</span></a>
          <a href={liveDemo} class="inline-flex min-h-11 items-center gap-2 px-3 text-sm font-medium underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">View demo <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <StudioAtmosphere />
    </section>

    <div class="border-y border-border py-8 text-center" aria-label="Supported coding agents">
      <p class="text-sm leading-relaxed text-muted-foreground">Works with coding agents like</p>
      <div class="studio-agent-logos mx-auto mt-6 grid max-w-2xl grid-cols-3 gap-3 text-foreground/80">
        {setupPaths.filter((path) => path.logo).map((path) => (
          <span class="studio-agent-brand flex flex-col items-center gap-3 text-sm font-medium leading-snug">
            <span class="hero-vendor-logo" style={"--vendor-logo: url(" + path.logo + ")"} aria-hidden="true"></span>
            <span>{path.title.replace(/ plugin$/, "")}</span>
          </span>
        ))}
      </div>
    </div>

    <div id="explore" class="py-10 sm:py-14">
      <div class="texture-bg rounded-xl border border-border p-3 sm:p-6">
        <StudioPreviewCarousel href={feedbackDemo} linkLabel="Try the Feedback Inbox example" />
      </div>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Explore the prototype, its context, and the artifacts behind it. Open the demo to try it yourself.</p>
    </div>

    <section id="make-it-yours" class="studio-story-section" aria-labelledby="systems-title">
      <div class="systems-composition grid items-center gap-8">
        <div>
          <h2 id="systems-title" class="studio-section-title">A foundation that feels like your product</h2>
          <p class="studio-intro">Bring your theme, components, context, and skills into a system your agent can reuse across prototypes.</p>
          <p class="studio-intro">Create different systems for products, marketing, or clients. Pick the right foundation for each idea.</p>
        </div>
        <StudioFoundation kind="system" />
      </div>
    </section>

    <section id="capture-context" class="studio-story-section" aria-labelledby="context-title">
      <div class="studio-story-split context-composition grid items-center gap-8">
        <div class="context-image">
          <StudioDocumentGallery />
        </div>
        <div>
          <h2 id="context-title" class="studio-section-title">Keep the thinking with the work</h2>
          <p class="studio-intro">Keep the brief, decisions, and open questions alongside the work. You and your agent write in the same Markdown documents.</p>
          <div class="mt-6 space-y-5">
            <div><h3 class="text-lg font-medium tracking-tight">Context for the system</h3><p class="mt-2 text-base leading-relaxed text-muted-foreground">Shared product knowledge and design principles.</p></div>
            <div><h3 class="text-lg font-medium tracking-tight">Context for the prototype</h3><p class="mt-2 text-base leading-relaxed text-muted-foreground">The problem, assumptions, and questions for this idea.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="give-it-shape" class="studio-story-section" aria-labelledby="artifacts-title">
      <h2 id="artifacts-title" class="studio-section-title">Give your idea shape</h2>
      <p class="studio-intro">Map a flow, sketch a layout, build an interactive experience, and capture decisions. Combine diagrams, wireframes, canvases, and documents in one prototype.</p>
      <StudioArtifactExplorer />
    </section>

    <section id="work-and-share" class="studio-story-section" aria-labelledby="workflow-title">
      <div class="studio-story-split grid items-center gap-8">
        <div>
          <h2 id="workflow-title" class="studio-section-title">Publish a website. Share a lasting link.</h2>
          <p class="studio-intro">Publish Design Studio as a static website on GitHub Pages, Netlify, Vercel, or another popular host. Your team gets durable links to explore prototypes and the thinking behind them.</p>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground">Keep editing locally. Publish updates to the same link.</p>
          <div class="mt-6 flex flex-wrap gap-5">
            <a href={feedbackDemo} class="studio-text-link">Try a published prototype <span aria-hidden="true">↗</span></a>
            <a href="#publish" class="studio-text-link">See publishing options <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <StudioWorkflow kind="published" />
      </div>
    </section>

    <section id="build-together" class="studio-story-section" aria-labelledby="together-title">
      <div class="studio-story-split grid items-center gap-8">
        <div>
          <h2 id="together-title" class="studio-section-title">Your own space. Room for a team.</h2>

          <div class="mt-6 space-y-5">
            <div><h3 class="text-lg font-medium tracking-tight">Start in Personal mode</h3><p class="mt-2 text-base leading-relaxed text-muted-foreground">Explore on your own with full control of your prototypes, systems, and settings.</p></div>
            <div><h3 class="text-lg font-medium tracking-tight">Design confidently in Team mode</h3><p class="mt-2 text-base leading-relaxed text-muted-foreground">Contributors edit their own prototypes. Admins manage access and assign maintainers for shared systems, giving everyone clear boundaries for their work.</p></div>
          </div>
        </div>
        <StudioTeamSpaces />
      </div>
    </section>

    <section id="get-started" class="scroll-mt-8 border-t border-border py-14 sm:py-20" aria-labelledby="setup-title">
      <h2 id="setup-title" class="text-3xl font-medium leading-tight tracking-tight sm:text-4xl">Set up locally. Publish in minutes.</h2>
      <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-muted-foreground">Run Design Studio on your computer, then publish a link for your team. Use your usual coding agent or install it yourself. The prompts guide your agent through both steps.</p>
      <div class="setup-step mt-10">
      <h3 class="text-2xl font-medium tracking-tight">1. Choose how to run locally</h3>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">Pick your agent for a guided setup, or install directly from GitHub yourself.</p>
      <div class="setup-paths mt-4">
        {setupPaths.filter((path) => path.id !== "source").map((path) => (
          <details class="setup-path" name="studio-setup-path">
            <summary class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
              <span class="setup-path-heading">
                {path.logo && <span class="setup-vendor-logo" style={"--vendor-logo: url(" + path.logo + ")"} aria-hidden="true"></span>}
                {!path.logo && <span class="setup-source-logo" aria-hidden="true"><Icon icon={GithubIcon} size={30} /></span>}
                <span><span class="block text-lg font-medium tracking-tight">{path.title}</span><span class="mt-0.5 block text-base leading-relaxed text-muted-foreground">{path.description}</span></span>
              </span>
              <span class="setup-expand" aria-hidden="true">+</span>
            </summary>
            <div class="setup-path-content max-w-3xl pb-6">
              <div>
                <p class="text-base leading-relaxed text-muted-foreground">{path.instructions}</p>
                <div class="setup-prompt mt-4 rounded-lg border border-border bg-card p-4 sm:p-5">
                  <p class="text-base leading-relaxed" data-setup-prompt>{path.prompt}</p>
                  <button type="button" hidden data-copy-prompt class={buttonVariants({ className: "mt-4 h-10 px-4 hover:opacity-90" })} aria-label={"Copy " + path.title + " setup prompt"}>Copy prompt</button>
                </div>
              </div>

            </div>
          </details>
        ))}
      </div>
      <details class="setup-path" name="studio-setup-path">
        <summary class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
          <span class="setup-path-heading"><span class="setup-source-logo" aria-hidden="true"><Icon icon={GithubIcon} size={30} /></span><span><span class="block text-lg font-medium tracking-tight">From GitHub</span><span class="mt-0.5 block text-base leading-relaxed text-muted-foreground">Set up with any coding agent, or install it yourself.</span></span></span>
          <span class="setup-expand" aria-hidden="true">+</span>
        </summary>
        <div class="setup-path-content max-w-3xl pb-6 text-base leading-relaxed text-muted-foreground">
          <p>Use your coding agent without a plugin. Copy this prompt into a local chat:</p>
          <div class="setup-prompt mt-4 mb-6 rounded-lg border border-border bg-card p-4 sm:p-5">
            <p class="text-foreground" data-setup-prompt>{setupPaths.find((path) => path.id === "source")?.prompt}</p>
            <button type="button" hidden data-copy-prompt class={buttonVariants({ className: "mt-4 h-10 px-4" })} aria-label="Copy GitHub setup prompt">Copy prompt</button>
          </div>
          <h4 class="mb-3 font-medium text-foreground">Or install it yourself</h4>
          <ol class="list-decimal space-y-3 pl-5">
            <li>Use <a href={repository} class="text-foreground underline underline-offset-4">the GitHub template</a> to create your own repository and clone it, or download the source.</li>
            <li>Install <a href="https://mise.jdx.dev/installing-mise.html" class="text-foreground underline underline-offset-4">mise</a>, then run these commands in the repository folder:</li>
          </ol>
          <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-card p-5 font-mono text-sm text-foreground"><code>mise install
mise exec -- pnpm install
mise exec -- pnpm dev</code></pre>
          <p class="mt-4">Open the local URL printed in your terminal. Explore independently, or open the folder in your coding agent to start building.</p>
        </div>
      </details>
      <a href={setupGuide} class="mt-4 inline-flex items-center gap-2 text-sm font-medium underline decoration-border underline-offset-4 hover:decoration-foreground">Full setup instructions <span aria-hidden="true">↗</span></a>
      </div>

      <div id="publish" class="setup-step mt-12 scroll-mt-8 border-t border-border pt-10" aria-labelledby="publish-title">
      <h3 id="publish-title" class="text-2xl font-medium tracking-tight">2. Choose where to publish</h3>
      <p class="studio-intro">Choose a host and copy its prompt into your Design Studio agent chat. Your agent handles publishing and updates to the same link.</p>
      <div class="setup-paths mt-8">
        {publishingPaths.map((path) => (
          <details class="setup-path" name="studio-publishing-path">
            <summary class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
              <span class="setup-path-heading">
                {path.logo && <span class="setup-vendor-logo" style={"--vendor-logo: url(" + path.logo + ")"} aria-hidden="true"></span>}
                {!path.logo && <span class="setup-source-logo" aria-hidden="true"><Icon icon={path.title === "GitHub Pages" ? GithubIcon : Robot01Icon} size={30} /></span>}
                <span><span class="block text-lg font-medium tracking-tight">{path.title}</span><span class="mt-1 block text-base leading-relaxed text-muted-foreground">{path.description}</span></span></span>
              <span class="setup-expand" aria-hidden="true">+</span>
            </summary>
            <div class="setup-path-content max-w-3xl pb-6">
              <p class="text-base leading-relaxed text-muted-foreground">{path.instructions}</p>
              <div class="setup-prompt mt-4 rounded-lg border border-border bg-card p-4 sm:p-5">
                <p class="text-base leading-relaxed" data-setup-prompt>{path.prompt}</p>
                <button type="button" hidden data-copy-prompt class={buttonVariants({ className: "mt-4 h-10 px-4" })} aria-label={"Copy " + path.title + " publishing prompt"}>Copy prompt</button>
              </div>
            </div>
          </details>
        ))}
      </div>
      </div>
      <p class="sr-only" data-copy-status role="status" aria-live="polite"></p>
    </section>

    <section class="border-t border-border pt-14 pb-20 sm:pt-20 sm:pb-24" aria-labelledby="about-studio-title">
      <h2 id="about-studio-title" class="text-3xl font-medium tracking-tight sm:text-4xl">A note from the creator</h2>
      <div class="mt-8 grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-14">
        <div class="creator-portrait-field md:order-2 relative isolate flex justify-center py-8 md:self-start md:py-0">
          <a href="/about" aria-label="About Patrick Morgan" class="relative z-10 block shrink-0 rotate-2 bg-white p-2 pb-8 shadow-2xl shadow-black/20 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring dark:bg-[#20201e] dark:shadow-black/50 lg:p-3 lg:pb-10 motion-reduce:transition-none">
            <div class="h-52 w-52 overflow-hidden lg:h-64 lg:w-64 xl:h-72 xl:w-72">
              <img src="/images/brand/profile-living-room.jpg" alt="Patrick Morgan" loading="lazy" class="block h-full w-full scale-[1.55] object-cover object-[43%_54%]" />
            </div>
          </a>
        </div>
        <div class="max-w-2xl space-y-5 text-base leading-relaxed text-muted-foreground md:order-1">
          <p>Hello friend,</p>
          <p>Design Studio is something I’ve wanted to exist for years.</p>
          <p>Over a decade ago, I started my tech career as a front-end developer embedded on a product design team. Prototyping and design technology have been central to my work ever since. This year, coding agents finally made it possible to build the environment I’d imagined and make that way of working accessible to more teams.</p>
          <p>Design Studio carries years of thinking and experimentation, shaped by using early versions with my teammates at Sublime Security. Their support and our day-to-day product and marketing work helped make it what it is.</p>
          <p>I’m sharing Design Studio freely and openly to help bring more good design into the world. I hope the community will make it better together. <a href={repository} class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground">Explore the code on GitHub</a>, adapt it, or contribute.</p>
          <p>I’d love to see what you build, hear what gets in your way, and help you make Design Studio fit your team.</p>
          <img src="/images/brand/patrick-signature.png" alt="Patrick Morgan" width="764" height="376" loading="lazy" class="h-auto w-32 dark:invert" />
          <a href="https://www.unknownarts.com/p/build-a-design-os" class="inline-block pt-3 text-sm font-medium text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground">Read the story behind Design Studio <span aria-hidden="true">→</span></a>
        </div>

      </div>
      <div class="mt-10">
        <a href="#get-started" class={buttonVariants({ size: "lg", className: "h-11 px-5" })}>Set up Design Studio <span aria-hidden="true">↑</span></a>
        <p class="mt-5 max-w-[65ch] text-base leading-relaxed text-muted-foreground">Share what you build and tag <a href={siteConfig.social.x} class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground">@itspatmorgan</a>. Follow more experiments in <a href={siteConfig.social.newsletter} class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground">Unknown Arts</a>.</p>
        <a href={repository} class="mt-3 inline-block text-sm underline decoration-border underline-offset-4 hover:decoration-foreground">Feedback and contributions on GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    </div>
    <section id="studio-agent" data-studio-panel="agent" hidden class="pt-16 pb-20 sm:pt-20 sm:pb-24">
      <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">Design Studio</h1>
      <p class="mt-4 max-w-[65ch] leading-relaxed text-muted-foreground">A project brief and setup guide for your coding agent.</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="button" data-copy-agent hidden class={buttonVariants({ variant: "outline", size: "sm" })}>Copy guide</button>
        <a href="/design-studio/agent.txt" class="text-sm underline decoration-border underline-offset-4 hover:decoration-foreground">Open plain text <span aria-hidden="true">↗</span></a>
      </div>
      <pre class="mt-8 whitespace-pre-wrap break-words rounded-xl border border-border bg-card p-5 font-mono text-xs leading-relaxed sm:p-8 sm:text-sm" data-agent-guide><code>{agentGuide}</code></pre>
      <p class="sr-only" data-agent-copy-status role="status" aria-live="polite"></p>
    </section>
  </div>
</PageLayout>

<style>
  .studio-page { container: studio-page / inline-size; }
  .studio-story-section { scroll-margin-top: 2rem; border-top: 1px solid var(--border); padding-block: 3.5rem; }
  .studio-section-title { font-size: clamp(1.875rem, 3.8cqi, 2.5rem); font-weight: 500; line-height: 1.12; letter-spacing: -0.035em; }
  #context-title, #together-title { text-wrap: balance; }
  .studio-intro { margin-top: 1.25rem; max-width: 65ch; font-size: 1rem; line-height: 1.7; color: var(--muted-foreground); }
  .studio-text-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 4px; }
  .studio-text-link:hover { text-decoration-color: var(--foreground); }
  .studio-text-link:focus-visible { outline: 2px solid var(--ring); outline-offset: 4px; }
  @container studio-page (min-width: 40rem) {
    .studio-story-section { padding-block: 5rem; }
    .studio-story-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  .studio-mode-icon { display: none; }
  .studio-hero { padding-top: clamp(3rem, 8.8cqi, 6rem); padding-bottom: clamp(3rem, 10.3cqi, 7rem); }
  @container studio-page (max-width: 39.999rem) {
    .studio-header { gap: 0.5rem; }
    .studio-brand { gap: 0.5rem; }
    .studio-brand > svg { width: 1.5rem; height: auto; }
    .studio-brand > span { font-size: clamp(0.875rem, 4.5cqi, 1.125rem); white-space: nowrap; }
    .studio-header-controls { gap: 0.25rem; }
    .studio-github { width: 2.75rem; justify-content: center; }
    .studio-control-label { display: none; }
    .studio-mode-icon { display: flex; }
    .studio-header .mode-tab { display: flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; padding: 0; }
    .studio-hero { padding-top: 1.5rem; }
    .studio-hero > :global(.studio-atmosphere) { grid-row: 1; max-width: 22rem; margin-inline: 0; }
    .studio-hero h1 { font-size: clamp(2rem, 5.9cqi, 2.5rem); }
    .studio-hero > div > p { margin-top: 1.5rem; font-size: 1rem; }
  }
  .systems-composition > :global(.foundation-system) { max-width: 27rem; }
  @container studio-page (min-width: 40rem) {
    .studio-hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 3.5cqi, 2.5rem); }
    .studio-hero h1 { font-size: clamp(2rem, 5.9cqi, 4rem); }
    .studio-hero > div > p { margin-top: 1.5rem; font-size: clamp(1rem, 1.7cqi, 1.125rem); }
    .studio-hero > :global(.studio-atmosphere) { max-width: 32rem; margin-inline: auto; }
    .systems-composition { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.5rem, 4cqi, 3.5rem); }
    .systems-composition h2 { font-size: clamp(1.75rem, 3.4cqi, 2.25rem); }
    #make-it-yours { padding-block: 3.5rem; }
    .system-layers { margin-top: clamp(1.5rem, 3cqi, 2rem); }
  }
  @container studio-page (min-width: 64rem) {
    .systems-composition { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; }
  }
  .setup-step > .setup-path { border-top: 1px solid var(--border); }
  .context-image { min-width: 0; }
  @container studio-page (max-width: 39.999rem) { .context-image { order: 2; } }
  .setup-path + .setup-path { border-top: 1px solid var(--border); }
  .setup-path summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 0; cursor: pointer; list-style: none; }
  .setup-path summary::-webkit-details-marker { display: none; }
  .setup-path-heading { display: flex; align-items: center; gap: 1rem; }
  .setup-vendor-logo { display: block; width: 2.5rem; height: 2.5rem; flex-shrink: 0; background: var(--foreground); mask: var(--vendor-logo) center / contain no-repeat; }
  .hero-vendor-logo { display: block; width: 1.75rem; height: 1.75rem; flex-shrink: 0; background: currentColor; mask: var(--vendor-logo) center / contain no-repeat; }
  @container studio-page (min-width: 40rem) {
    .studio-agent-brand { flex-direction: row; justify-content: center; gap: 0.75rem; font-size: 1.125rem; white-space: nowrap; }
    .studio-agent-logos { gap: 2rem; }
  }
  .setup-source-logo { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; flex-shrink: 0; }
  .setup-expand { flex-shrink: 0; font: 1.5rem var(--font-mono); color: var(--muted-foreground); transition: transform 180ms ease; }
  .setup-path[open] .setup-expand { transform: rotate(45deg); }
  .setup-prompt { overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) { .setup-expand { transition: none; } }
  .creator-portrait-field::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(1deg);
    background-image: radial-gradient(currentColor 1px, transparent 1.5px);
    background-size: 14px 14px;
    color: var(--foreground);
    opacity: 0.105;
    mask-image: radial-gradient(ellipse at 55% 54%, black 0%, black 52%, transparent 82%);
  }
  @media (min-width: 48rem) {
    .creator-portrait-field::before { width: calc(100% + min(6rem, 6vw)); height: 26rem; }
  }
  [data-studio-panel][hidden] { display: none; }
  .mode-indicator { position:absolute; z-index:-1; left:0; top:4px; bottom:4px; width:0; border-radius:999px; background:var(--foreground); pointer-events:none; }
  [data-studio-modes][data-initialized="true"] .mode-indicator { transition:transform 260ms cubic-bezier(.22,1,.36,1), width 260ms cubic-bezier(.22,1,.36,1); }
  .mode-tab { color: var(--muted-foreground); transition:color 180ms ease; }
  .mode-tab:hover { color: var(--foreground); }
  .mode-tab[aria-selected="true"] { color: var(--background); }
  @media (prefers-reduced-motion: reduce) {
    [data-studio-modes][data-initialized="true"] .mode-indicator,.mode-tab { transition:none; }
  }
  .code-block { position: relative; margin-top: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); }
  .code-block pre { overflow-x: auto; padding: 1.25rem 4.5rem 1.25rem 1.25rem; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.9; }
  .code-block-placeholder pre { padding-right: 1.25rem; }
  .code-block button { position: absolute; right: 0.75rem; top: 0.65rem; padding: 0.25rem 0.6rem; border: 1px solid var(--border); border-radius: 0.3rem; font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted-foreground); }
  .code-block button:hover { color: var(--foreground); background: var(--muted); }
  .code-block button:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
</style>

<script>
  import { dissolvePixelWave } from "@/scripts/pixel-wave";
  import { animate } from "motion";

  function initStudioPage() {
    const human = document.querySelector<HTMLElement>("#studio-human");
    if (human && !human.dataset.visualMotionInitialized) {
      human.dataset.visualMotionInitialized = "true";
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const running = new Set<Animation>();
      // Images remain visible without JavaScript. Animate once as each enters view.
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          if (reduced.matches) return;
          const animation = entry.target.animate([{ opacity: 0.7, transform: "translateY(12px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 500, easing: "cubic-bezier(.22,1,.36,1)" });
          running.add(animation);
          animation.finished.then(() => running.delete(animation)).catch(() => running.delete(animation));
        });
      }, { threshold: 0.2 });
      human.querySelectorAll(".studio-story-section figure, .foundation-system, .workflow-art").forEach((visual) => { if (!visual.closest("[data-artifact-explorer]")) observer.observe(visual); });
      const stopMotion = () => { if (reduced.matches) running.forEach((animation) => animation.cancel()); };
      reduced.addEventListener("change", stopMotion);
      document.addEventListener("astro:before-swap", () => { observer.disconnect(); running.forEach((animation) => animation.cancel()); reduced.removeEventListener("change", stopMotion); }, { once: true });
    }
    const headline = document.querySelector<HTMLElement>("#studio-title");
    if (headline && !headline.dataset.waveInitialized) {
      headline.dataset.waveInitialized = "true";
      headline.querySelectorAll<HTMLElement>("[data-pixel-wave]").forEach(dissolvePixelWave);
    }
    const modeList = document.querySelector<HTMLElement>("[data-studio-modes]");
    if (modeList && !modeList.dataset.initialized) {
      const modes = Array.from(modeList.querySelectorAll<HTMLAnchorElement>("[data-studio-mode]"));
      const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-studio-panel]"));
      const indicator = modeList.querySelector<HTMLElement>("[data-mode-indicator]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let selected = 0;
      let visible = 0;
      let sequence = 0;
      let animations: Animation[] = [];
      const positionIndicator = () => {
        if (!indicator) return;
        indicator.style.width = `${modes[selected].offsetWidth}px`;
        indicator.style.transform = `translateX(${modes[selected].offsetLeft}px)`;
      };
      async function selectMode(index: number, focus = false, transition = true) {
        selected = index;
        modes.forEach((tab, i) => { tab.setAttribute("aria-selected", String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        positionIndicator();
        if (focus) modes[index].focus();
        const revision = ++sequence;
        animations.forEach(animation => animation.cancel());
        animations = [];
        const outgoing = panels[visible];
        const incoming = panels[index];
        if (transition && !reducedMotion.matches && visible !== index) {
          outgoing.inert = true;
          const fadeOut = outgoing.animate({ opacity: [1, 0] }, { duration: 110, easing: "ease-out", fill: "both" });
          animations.push(fadeOut);
          await fadeOut.finished.catch(() => {});
          if (revision !== sequence) return;
        }
        panels.forEach((panel, i) => { panel.hidden = i !== index; panel.inert = i !== index; });
        animations.forEach(animation => animation.cancel());
        animations = [];
        const changed = visible !== index;
        visible = index;
        if (transition && changed && !reducedMotion.matches) {
          const fadeIn = incoming.animate(
            { opacity: [0, 1], transform: ["translateY(3px)", "translateY(0)"] },
            { duration: 200, easing: "cubic-bezier(.22,1,.36,1)" },
          );
          animations.push(fadeIn);
        }
      }
      modeList.setAttribute("role", "tablist");
      modes.forEach((tab, index) => {
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panels[index].id);
        panels[index].setAttribute("role", "tabpanel");
        panels[index].setAttribute("aria-labelledby", tab.id);
        panels[index].tabIndex = 0;
        tab.addEventListener("click", (event) => { event.preventDefault(); selectMode(index); });
        tab.addEventListener("keydown", (event) => {
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
          event.preventDefault();
          selectMode(event.key === "Home" ? 0 : event.key === "End" ? modes.length - 1 : (index + (event.key === "ArrowLeft" ? -1 : 1) + modes.length) % modes.length, true);
        });
      });
      selectMode(window.location.hash === "#studio-agent" ? 1 : 0, false, false);
      const resize = new ResizeObserver(positionIndicator);
      resize.observe(modeList);
      document.addEventListener("astro:before-swap", () => {
        ++sequence;
        resize.disconnect();
        animations.forEach(animation => animation.cancel());
      }, { once: true });
      modeList.dataset.initialized = "true";
    }
    const copyAgent = document.querySelector<HTMLButtonElement>("[data-copy-agent]");
    if (copyAgent && navigator.clipboard?.writeText && !copyAgent.dataset.initialized) {
      copyAgent.hidden = false;
      copyAgent.dataset.initialized = "true";
      copyAgent.addEventListener("click", async () => {
        const text = document.querySelector("[data-agent-guide]")?.textContent;
        const status = document.querySelector<HTMLElement>("[data-agent-copy-status]");
        if (!text) return;
        try { await navigator.clipboard.writeText(text); if (status) status.textContent = "Guide copied to clipboard."; copyAgent.textContent = "Copied"; }
        catch { if (status) status.textContent = "Couldn't copy. Open the plain text guide to select and copy it."; }
        window.setTimeout(() => { copyAgent.textContent = "Copy guide"; }, 2000);
      });
    }
    if (!navigator.clipboard?.writeText) return;
    document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]").forEach((button) => {
      if (button.dataset.initialized === "true") return;
      button.hidden = false;
      button.dataset.initialized = "true";
      button.addEventListener("click", async () => {
        const code = button.parentElement?.querySelector("[data-setup-prompt]")?.textContent;
        const status = document.querySelector<HTMLElement>("[data-copy-status]");
        if (!code) return;
        try { await navigator.clipboard.writeText(code); button.textContent = "Copied"; if (status) status.textContent = "Prompt copied to clipboard."; }
        catch { if (status) status.textContent = "Couldn't copy. Select and copy the prompt directly."; }
        window.setTimeout(() => { button.textContent = "Copy prompt"; }, 2000);
      });
    });
  }
  initStudioPage();
  document.addEventListener("astro:after-swap", initStudioPage);
</script>
