---
import PageLayout from "@/layouts/PageLayout.astro";
import Icon from "@/components/icons/Icon.astro";
import PixelWaveText from "@/components/PixelWaveText.astro";
import agentGuide from "@/data/design-studio-agent.txt?raw";
import { setupGuide, publishingGuide, agentHarnesses, publishingHosts, installationPrompt, publishingPrompt } from "@/data/design-studio-setup";
import { buttonVariants } from "@/components/ui/button";
import { siteConfig } from "@/data/site-config";
import { GithubIcon, UserIcon, Robot01Icon, ArrowUpRight01Icon, ArrowDown01Icon, ArrowRight01Icon, Copy01Icon } from "@hugeicons/core-free-icons";
import Slide from "@/components/case-study/Slide.astro";
import StudioShapes from "@/components/design-studio/StudioShapes";
import Spectrum from "@/components/studio-case/Spectrum";
import StudioSystem from "@/components/design-studio/StudioSystem";
import StudioDocs from "@/components/design-studio/StudioDocs";
import "@/components/case-study/case-study.css";
import "@/components/studio-case/studio-case.css";

const repository = "https://github.com/itspatmorgan/design-studio";
const liveDemo = "https://itspatmorgan.com/design-studio-demo/";


---

<PageLayout template="showcase" title="Design Studio: Design with intent. Build with an agent." description="Design Studio is an open source, AI prototype sandbox for designers and product managers who build." image="/images/share/design-studio.jpg">
  <div class="studio-page mx-auto w-full max-w-[1136px] px-6 sm:px-8 lg:px-14">
    <header class="studio-header flex items-center justify-between gap-6 pt-9 sm:pt-12">
      <a href="/design-studio" class="studio-brand flex shrink-0 items-center gap-3 font-medium tracking-tight" aria-label="Design Studio home — public beta, under active development">
        <svg width="32" height="26" viewBox="0 0 40 32" fill="currentColor" aria-hidden="true"><path d="M0 0h11v32H0zM15 0h3a16 16 0 0 1 0 32h-3z" /></svg>
        <span class="studio-brand-label flex items-center gap-2">
          <span class="studio-brand-name text-lg">Design Studio</span>
          <span class="rounded-full border border-border bg-muted px-2 py-0.5 font-mono text-xs leading-tight tracking-wide text-muted-foreground" title="Public beta · Under active development">Beta</span>
        </span>
      </a>
      <div class="studio-header-controls ml-auto flex shrink-0 items-center gap-4 sm:gap-6">
        <a href={repository} aria-label="View Design Studio on GitHub" title="View Design Studio on GitHub" class="studio-github inline-flex min-h-11 items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
          <span aria-hidden="true"><Icon icon={GithubIcon} size={20} /></span>
          <span class="studio-control-label">GitHub</span>
        </a>
        <nav aria-label="Reading mode" class="relative isolate flex rounded-full border border-border p-1" data-studio-modes>
          <span class="mode-indicator" aria-hidden="true" data-mode-indicator></span>
          <a id="studio-human-tab" href="#studio-human" data-studio-mode="human" aria-label="Human" title="Human" class="mode-tab rounded-full px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"><span class="studio-mode-icon" aria-hidden="true"><Icon icon={UserIcon} size={18} /></span><span class="studio-control-label">Human</span></a>
          <a id="studio-agent-tab" href="/design-studio/agent.txt" data-studio-mode="agent" aria-label="Agent" title="Agent" class="mode-tab font-mono rounded-full px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"><span class="studio-mode-icon" aria-hidden="true"><Icon icon={Robot01Icon} size={18} /></span><span class="studio-control-label">Agent</span></a>
        </nav>
      </div>
    </header>

    <div id="studio-human" data-studio-panel="human" class="cs-page sc ds-landing">
    <header class="cs-slide cs-hero ds-hero" aria-labelledby="studio-title">
      <h1 id="studio-title"><PixelWaveText text="Design with intent." wave="studio-headline" initialSans /><br /><PixelWaveText text="Build with an agent." wave="studio-headline" initialSans /></h1>
      <p>Design Studio is an open source, AI prototype sandbox for designers and product managers who build.</p>
      <div class="sc-next ds-actions">
        <a href="#get-started" class="is-primary" data-copy-text={installationPrompt} data-copy-label="Copy setup prompt" data-copy-done="Copied. Paste it into your agent"><Icon icon={Copy01Icon} size={16} class="shrink-0" /><span data-copy-face>Copy setup prompt</span></a>
        <a href={liveDemo}>Try the live demo <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a>
      </div>
      <div class="ds-works">
        <span class="ds-works-row">Paste it into
          {agentHarnesses.map((harness) => (
            <span class="ds-harness"><span class="hero-vendor-logo ds-logo" style={"--vendor-logo: url(" + harness.logo + ")"} aria-hidden="true"></span>{harness.title}</span>
          ))}
        </span>
        <span class="ds-works-row">Or point your agent at <a href="/design-studio/agent.txt">itspatmorgan.com/design-studio/agent.txt</a></span>
      </div>
      <StudioShapes client:load />
    </header>

    <section class="cs-slide ds-proof" aria-label="Who uses Design Studio">
      <figure class="sc-quote">
        <blockquote>“We have essentially replaced Figma with this at Sublime.”</blockquote>
        <figcaption>Joe Salowitz, Product Designer at Sublime, <a href="https://x.com/JoeSalowitz/status/2114915923283120187" target="_blank" rel="noopener noreferrer">on X</a></figcaption>
      </figure>
      <dl class="cs-brief ds-stats">
        <div><dt>At Sublime</dt><dd>About a dozen people</dd></div>
        <div><dt>Prototypes</dt><dd>Hundreds, more each week</dd></div>
        <div><dt>Launch lesson</dt><dd>600+ signed up</dd></div>
        <div><dt>Launch posts</dt><dd>30k+ views</dd></div>
      </dl>
      <a class="ds-case-link" href="/work/design-studio">How Sublime’s product team uses it <Icon icon={ArrowRight01Icon} size={14} class="shrink-0" /></a>
    </section>

    <Slide id="why-title" title="Between a one-off prototype and the production repo" line="Design Studio uses your product’s components and rules, so designs look real, and lives in its own repo, so trying ideas stays fast.">
      <Spectrum client:visible />
    </Slide>

    <Slide id="systems-title" title="Your design system, ready for your agent" line="Bring your theme, components, context and skills. Every component is documented with live examples, so your agent builds with the real thing.">
      <StudioSystem client:visible />
    </Slide>

    <Slide id="context-title" title="Keep the thinking with the work" line="Briefs, decisions and open questions live beside the prototype as Markdown. Your team reads the page, and your agent reads and writes the same file.">
      <StudioDocs client:visible />
    </Slide>

    <section class="cs-slide ds-share" aria-labelledby="share-title">
      <h2 id="share-title">Share a lasting link with your team</h2>
      <p>Publish Design Studio as a static website on Vercel, Netlify, Cloudflare or another host. Keep editing locally, and publish updates to the same link.</p>
      <div class="ds-share-grid">
        <div><h3>Publish a website</h3><p>Your team explores the prototypes and the thinking behind them in the browser, with nothing to install.</p><a href={liveDemo}>Explore a published Studio <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a></div>
        <div><h3>Start in Personal mode</h3><p>Explore on your own, with full control of your prototypes, systems and settings.</p></div>
        <div><h3>Grow into Team mode</h3><p>Contributors edit their own prototypes. Admins manage access and assign maintainers for shared systems.</p></div>
      </div>
    </section>

    <section id="get-started" class="cs-slide ds-start" aria-labelledby="setup-title">
      <h2 id="setup-title">Get started with your agent</h2>
      <p>Paste a prompt into your coding agent. It installs Design Studio and opens the preview, then helps you publish when you’re ready to share.</p>
      <div class="studio-story-split studio-action-grid ds-start-grid">
        <section class="flex min-w-0 flex-col" aria-labelledby="install-title">
          <h3 id="install-title" class="text-xl font-medium tracking-tight sm:text-2xl">1. Install and run locally</h3>
          <p class="mt-3 text-base leading-relaxed text-muted-foreground">Use the agent harness you already use.</p>

          <div class="setup-prompt texture-bg mt-6 flex flex-1 flex-col rounded-xl border border-border p-5 sm:p-7">
            <p class="mb-4 text-base leading-relaxed" data-setup-prompt>{installationPrompt}</p>
            <button type="button" hidden data-copy-prompt class={buttonVariants({ className: "mt-auto h-10 self-start px-4" })} aria-label="Copy Design Studio installation prompt">Copy installation prompt</button>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-muted-foreground" aria-label="Example agent harnesses for Design Studio">
            {agentHarnesses.map((harness) => (
              <span class="inline-flex items-center gap-2 text-sm">
                <span class="hero-vendor-logo setup-compatibility-logo" style={"--vendor-logo: url(" + harness.logo + ")"} aria-hidden="true"></span>
                <span>{harness.title}</span>
              </span>
            ))}
            <span class="whitespace-nowrap text-sm">and more</span>
          </div>
          <a href={setupGuide} class="mt-4 inline-flex items-center gap-2 self-start text-sm font-medium underline underline-offset-4 transition-colors hover:text-accent">Full installation guide <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a>
        </section>
        <section id="publish" class="flex min-w-0 scroll-mt-8 flex-col" aria-labelledby="publish-title">
          <h3 id="publish-title" class="text-xl font-medium tracking-tight sm:text-2xl">2. Publish and share</h3>
          <p class="mt-3 text-base leading-relaxed text-muted-foreground">Publish a static website on the host you choose.</p>

          <div class="setup-prompt texture-bg mt-6 flex flex-1 flex-col rounded-xl border border-border p-5 sm:p-7">
            <p class="mb-4 text-base leading-relaxed" data-setup-prompt>{publishingPrompt}</p>
            <button type="button" hidden data-copy-prompt class={buttonVariants({ className: "mt-auto h-10 self-start px-4" })} aria-label="Copy Design Studio publishing prompt">Copy publishing prompt</button>
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-muted-foreground" aria-label="Example hosting services for Design Studio">
            {publishingHosts.map((host) => (
              <span class="inline-flex items-center gap-2 text-sm">
                <span class="hero-vendor-logo setup-compatibility-logo" style={"--vendor-logo: url(" + host.logo + ")"} aria-hidden="true"></span>
                <span>{host.title}</span>
              </span>
            ))}
            <span class="whitespace-nowrap text-sm">and more</span>
          </div>
          <a href={publishingGuide} class="mt-4 inline-flex items-center gap-2 self-start text-sm font-medium underline underline-offset-4 transition-colors hover:text-accent">Full publishing guide <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a>
        </section>
      </div>
      <p class="ds-community">Built something? <a href="https://github.com/itspatmorgan/design-studio/discussions">Share it with the community on GitHub</a>, or tag <a href={siteConfig.social.x}>@itspatmorgan</a> on X.</p>
      <p class="sr-only" data-copy-status role="status" aria-live="polite"></p>
    </section>

    <section class="ds-note" aria-labelledby="about-studio-title">
      <h2 id="about-studio-title" class="text-3xl font-medium tracking-tight sm:text-4xl">A note from the creator</h2>
      <div class="mt-8 grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-14">
        <div class="creator-portrait-field md:order-2 relative isolate flex justify-center py-8 md:self-start md:py-0">
          <a href="/about" aria-label="About Patrick Morgan" class="relative z-10 block shrink-0 rotate-2 bg-white p-2 pb-8 shadow-2xl shadow-black/20 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring dark:bg-[#20201e] dark:shadow-black/50 lg:p-3 lg:pb-10 motion-reduce:transition-none">
            <div class="h-52 w-52 overflow-hidden lg:h-64 lg:w-64 xl:h-72 xl:w-72">
              <img src="/images/brand/profile-living-room.jpg" alt="Patrick Morgan" loading="lazy" class="block h-full w-full scale-[1.55] object-cover object-[43%_54%]" />
            </div>
          </a>
        </div>
        <div class="max-w-2xl space-y-5 text-base leading-relaxed text-muted-foreground md:order-1">
          <p>Hello friend,</p>
          <p>Design Studio is something I’ve wanted to exist for years.</p>
          <p>Over a decade ago, I started my tech career as a front-end developer embedded on a product design team. Prototyping and design technology have been central to my work ever since. This year, coding agents finally made it possible to build the environment I’d imagined and make that way of working accessible to more teams.</p>
          <p>Design Studio carries years of thinking and experimentation, shaped by using early versions with my teammates at Sublime Security. Their support and our day-to-day product and marketing work helped make it what it is.</p>
          <p>I’m sharing Design Studio freely and openly to help bring more good design into the world. I hope the community will make it better together. <a href={repository} class="text-foreground underline underline-offset-4 transition-colors hover:text-accent">Explore the code on GitHub</a>, adapt it, or contribute.</p>
          <p>I’d love to see what you build, hear what gets in your way, and help you make Design Studio fit your team.</p>
          <img src="/images/brand/patrick-signature.png" alt="Patrick Morgan" width="764" height="376" loading="lazy" class="h-auto w-32 dark:invert" />
          <nav aria-label="More about Design Studio" class="pt-3 text-foreground">
            <a href="https://www.unknownarts.com/p/build-a-design-os" class="studio-text-link">Read the Design Studio story <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a>
            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
              <li><a href={siteConfig.social.x} class="studio-text-link">X profile <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a></li>
              <li><a href={siteConfig.social.newsletter} class="studio-text-link">Unknown Arts newsletter <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a></li>
              <li><a href={repository} class="studio-text-link">GitHub repo <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a></li>
            </ul>
          </nav>
        </div>
      </div>
    </section>
    </div>
    <section id="studio-agent" data-studio-panel="agent" hidden class="pt-16 pb-20 sm:pt-20 sm:pb-24">
      <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">Design Studio</h1>
      <p class="mt-4 max-w-[65ch] leading-relaxed text-muted-foreground">A project brief and setup guide for your coding agent.</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="button" data-copy-agent hidden class={buttonVariants({ variant: "outline", size: "sm" })}>Copy guide</button>
        <a href="/design-studio/agent.txt" class="inline-flex items-center gap-2 text-sm text-foreground underline underline-offset-4 transition-colors hover:text-accent">Open plain text <Icon icon={ArrowUpRight01Icon} size={14} class="shrink-0" /></a>
      </div>
      <pre class="mt-8 whitespace-pre-wrap break-words rounded-xl border border-border bg-card p-5 font-mono text-xs leading-relaxed sm:p-8 sm:text-sm" data-agent-guide><code>{agentGuide}</code></pre>
      <p class="sr-only" data-agent-copy-status role="status" aria-live="polite"></p>
    </section>
  </div>
</PageLayout>

<style>
  .studio-page { container: studio-page / inline-size; }
  /* The landing page shares the case studies' slide rhythm and stages (case-study.css), inside the Showcase shell. */
  .ds-landing.cs-page { max-width: none; margin: 0; padding: 0; }
  .ds-hero { padding-top: clamp(56px, 8cqi, 96px); }
  .ds-hero > h1 { max-width: none; font-size: clamp(40px, 5.6cqi, 68px); line-height: 1.02; }
  .ds-hero > p { max-width: 34em; margin-top: 24px; }
  .ds-actions { margin-top: 36px; }
  .ds-actions a { height: 44px; padding: 0 20px; font-size: 15px; }
  .ds-actions a [data-copy-face] { transition: opacity 160ms ease; }
  .ds-works { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 24px; font-size: 14px; line-height: 20px; color: var(--muted-foreground); }
  .ds-works-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 14px; }
  .ds-harness { display: inline-flex; align-items: center; gap: 6px; color: var(--foreground); }
  .ds-works .ds-logo { width: 16px; height: 16px; }
  .ds-works a { color: var(--foreground); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  .ds-works a:hover { text-decoration-color: currentColor; }
  .ds-hero > :global(.cs-scene) { margin-top: 64px; }
  .ds-proof { padding-top: 128px; }
  .ds-stats { margin-top: 48px; }
  .ds-case-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 40px; font-size: 15px; font-weight: 500; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  .ds-case-link:hover { text-decoration-color: currentColor; }
  .ds-share-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; max-width: 1024px; margin: 48px auto 0; text-align: left; }
  .ds-share-grid > div { display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); }
  .ds-share-grid h3 { font-size: 17px; line-height: 24px; font-weight: 500; letter-spacing: -.01em; }
  .ds-share-grid p { margin-top: 8px; font-size: 15px; line-height: 23px; color: var(--muted-foreground); }
  .ds-share-grid a, .ds-community a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
  .ds-share-grid a { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 20px; font-size: 14px; font-weight: 500; }
  .ds-share-grid a:hover, .ds-community a:hover { text-decoration-color: currentColor; }
  .ds-start-grid { max-width: 1024px; margin: 48px auto 0; text-align: left; }
  .ds-start > .ds-community { margin-top: 48px; font-size: 16px; }
  .ds-community a { color: var(--foreground); }
  .ds-note { padding: 144px 0 96px; }
  @media (max-width: 860px) { .ds-share-grid { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin-top: 28px; gap: 12px; } }
  @media (max-width: 760px) { .ds-note { padding-top: 88px; } .ds-start-grid { margin-top: 28px; } }
  @media (max-width: 640px) {
    .ds-actions a { height: 40px; padding: 0 16px; font-size: 14px; }
    .ds-works { font-size: 13px; }
    .ds-works-row { gap: 4px 10px; }
  }
  .studio-text-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500; text-decoration: underline; text-underline-offset: 4px; transition: color 150ms; }
  .studio-text-link:hover { color: var(--accent); }
  .studio-text-link:focus-visible { outline: 2px solid var(--ring); outline-offset: 4px; }
  .studio-mode-icon { display: none; }
  @container studio-page (max-width: 39.999rem) {
    .studio-header { gap: 0.5rem; }
    .studio-brand { gap: 0.5rem; }
    .studio-brand > svg { width: 1.5rem; height: auto; }
    .studio-brand-label { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    .studio-brand-name { font-size: clamp(0.875rem, 4.5cqi, 1.125rem); white-space: nowrap; }
    .studio-header-controls { gap: 0.25rem; }
    .studio-github { width: 2.75rem; justify-content: center; }
    .studio-control-label { display: none; }
    .studio-mode-icon { display: flex; }
    .studio-header .mode-tab { display: flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; padding: 0; }
  }
  .hero-vendor-logo { display: block; width: 1.75rem; height: 1.75rem; flex-shrink: 0; background: currentColor; mask: var(--vendor-logo) center / contain no-repeat; }
  .setup-compatibility-logo { width: 1.25rem; height: 1.25rem; }
  .setup-prompt { overflow-wrap: anywhere; }
  .studio-action-grid { display: grid; gap: 2rem; }
  .studio-action-grid > div { min-width: 0; }
  @container studio-page (min-width: 40rem) { .studio-story-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .creator-portrait-field::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(1deg);
    background-image: radial-gradient(currentColor 1px, transparent 1.5px);
    background-size: 14px 14px;
    color: var(--foreground);
    opacity: 0.105;
    mask-image: radial-gradient(ellipse at 55% 54%, black 0%, black 52%, transparent 82%);
  }
  @media (min-width: 48rem) {
    .creator-portrait-field::before { width: calc(100% + min(6rem, 6vw)); height: 26rem; }
  }
  [data-studio-panel][hidden] { display: none; }
  .mode-indicator { position:absolute; z-index:-1; left:0; top:4px; bottom:4px; width:0; border-radius:999px; background:var(--foreground); pointer-events:none; }
  [data-studio-modes][data-initialized="true"] .mode-indicator { transition:transform 260ms cubic-bezier(.22,1,.36,1), width 260ms cubic-bezier(.22,1,.36,1); }
  .mode-tab { color: var(--muted-foreground); transition:color 180ms ease; }
  [data-studio-modes]:not([data-initialized]) [data-studio-mode="human"] { background: var(--foreground); color: var(--background); }
  .mode-tab:hover { color: var(--foreground); }
  .mode-tab[aria-selected="true"] { color: var(--background); }
  @media (prefers-reduced-motion: reduce) {
    [data-studio-modes][data-initialized="true"] .mode-indicator,.mode-tab { transition:none; }
  }
</style>

<script>
  import { enablePixelHover } from "@/scripts/pixel-wave";

  function initStudioPage() {
    const headline = document.querySelector<HTMLElement>("#studio-title");
    if (headline && !headline.dataset.waveInitialized) {
      headline.dataset.waveInitialized = "true";
      headline.querySelectorAll<HTMLElement>("[data-pixel-wave]").forEach(enablePixelHover);
    }
    const modeList = document.querySelector<HTMLElement>("[data-studio-modes]");
    if (modeList && !modeList.dataset.initialized) {
      const modes = Array.from(modeList.querySelectorAll<HTMLAnchorElement>("[data-studio-mode]"));
      const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-studio-panel]"));
      const indicator = modeList.querySelector<HTMLElement>("[data-mode-indicator]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let selected = 0;
      let visible = 0;
      let sequence = 0;
      let animations: Animation[] = [];
      const positionIndicator = () => {
        if (!indicator) return;
        indicator.style.width = `${modes[selected].offsetWidth}px`;
        indicator.style.transform = `translateX(${modes[selected].offsetLeft}px)`;
      };
      async function selectMode(index: number, focus = false, transition = true) {
        selected = index;
        modes.forEach((tab, i) => { tab.setAttribute("aria-selected", String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        positionIndicator();
        if (focus) modes[index].focus();
        const revision = ++sequence;
        animations.forEach(animation => animation.cancel());
        animations = [];
        const outgoing = panels[visible];
        const incoming = panels[index];
        if (transition && !reducedMotion.matches && visible !== index) {
          outgoing.inert = true;
          const fadeOut = outgoing.animate({ opacity: [1, 0] }, { duration: 110, easing: "ease-out", fill: "both" });
          animations.push(fadeOut);
          await fadeOut.finished.catch(() => {});
          if (revision !== sequence) return;
        }
        panels.forEach((panel, i) => { panel.hidden = i !== index; panel.inert = i !== index; });
        animations.forEach(animation => animation.cancel());
        animations = [];
        const changed = visible !== index;
        visible = index;
        if (transition && changed && !reducedMotion.matches) {
          const fadeIn = incoming.animate(
            { opacity: [0, 1], transform: ["translateY(3px)", "translateY(0)"] },
            { duration: 200, easing: "cubic-bezier(.22,1,.36,1)" },
          );
          animations.push(fadeIn);
        }
      }
      modeList.setAttribute("role", "tablist");
      modes.forEach((tab, index) => {
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panels[index].id);
        panels[index].setAttribute("role", "tabpanel");
        panels[index].setAttribute("aria-labelledby", tab.id);
        panels[index].tabIndex = 0;
        tab.addEventListener("click", (event) => { event.preventDefault(); selectMode(index); });
        tab.addEventListener("keydown", (event) => {
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
          event.preventDefault();
          selectMode(event.key === "Home" ? 0 : event.key === "End" ? modes.length - 1 : (index + (event.key === "ArrowLeft" ? -1 : 1) + modes.length) % modes.length, true);
        });
      });
      selectMode(window.location.hash === "#studio-agent" ? 1 : 0, false, false);
      const resize = new ResizeObserver(positionIndicator);
      resize.observe(modeList);
      document.addEventListener("astro:before-swap", () => {
        ++sequence;
        resize.disconnect();
        animations.forEach(animation => animation.cancel());
      }, { once: true });
      modeList.dataset.initialized = "true";
    }
    const copyAgent = document.querySelector<HTMLButtonElement>("[data-copy-agent]");
    if (copyAgent && navigator.clipboard?.writeText && !copyAgent.dataset.initialized) {
      copyAgent.hidden = false;
      copyAgent.dataset.initialized = "true";
      copyAgent.addEventListener("click", async () => {
        const text = document.querySelector("[data-agent-guide]")?.textContent;
        const status = document.querySelector<HTMLElement>("[data-agent-copy-status]");
        if (!text) return;
        try { await navigator.clipboard.writeText(text); if (status) status.textContent = "Guide copied to clipboard."; copyAgent.textContent = "Copied"; }
        catch { if (status) status.textContent = "Couldn't copy. Open the plain text guide to select and copy it."; }
        window.setTimeout(() => { copyAgent.textContent = "Copy guide"; }, 2000);
      });
    }
    if (!navigator.clipboard?.writeText) return;
    document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]").forEach((button) => {
      if (button.dataset.initialized === "true") return;
      button.hidden = false;
      button.dataset.initialized = "true";
      const label = button.textContent ?? "";
      button.addEventListener("click", async () => {
        const code = button.parentElement?.querySelector("[data-setup-prompt]")?.textContent;
        const status = document.querySelector<HTMLElement>("[data-copy-status]");
        if (!code) return;
        try { await navigator.clipboard.writeText(code); button.textContent = "Copied"; if (status) status.textContent = "Prompt copied to clipboard."; }
        catch { if (status) status.textContent = "Couldn't copy. Select and copy the prompt directly."; }
        window.setTimeout(() => { button.textContent = label; }, 2000);
      });
    });
    // The hero's setup prompt: a link to the setup section that copies the prompt instead, where the clipboard is available.
    document.querySelectorAll<HTMLAnchorElement>("[data-copy-text]").forEach((link) => {
      if (link.dataset.initialized === "true") return;
      link.dataset.initialized = "true";
      const face = link.querySelector<HTMLElement>("[data-copy-face]");
      let timer = 0;
      link.addEventListener("click", async (event) => {
        event.preventDefault();
        const status = document.querySelector<HTMLElement>("[data-copy-status]");
        try {
          await navigator.clipboard.writeText(link.dataset.copyText ?? "");
          if (face) face.textContent = link.dataset.copyDone ?? "Copied";
          if (status) status.textContent = "Setup prompt copied. Paste it into your coding agent.";
          window.clearTimeout(timer);
          timer = window.setTimeout(() => { if (face) face.textContent = link.dataset.copyLabel ?? ""; }, 2600);
        } catch { document.querySelector("#get-started")?.scrollIntoView({ behavior: "smooth" }); }
      });
    });
  }
  initStudioPage();
  document.addEventListener("astro:after-swap", initStudioPage);
</script>
